{
  "name": "manage-company-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.105.0",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "postcss": "8.5.1",
    "prettier": "3.9.9",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --max-warnings=0"
    ],
    "*.{css,json,md}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "source-map-js": "1.2.2"
    }
  }
}
